# Crea backend/.env con el asistente:  npm run configurar
# (o copia este archivo como .env y completa los valores a mano).
PORT=3001

# ── Tutor de IA: Google Gemini ─────────────────────────────
# Clave gratuita en https://aistudio.google.com/apikey
IA_PROVEEDOR=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ── MySQL 5.7 (registro de datos e historial de operaciones) ─
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=estadistica

# Orígenes permitidos (opcional, separados por comas). Vacío = todos.
CORS_ORIGIN=
